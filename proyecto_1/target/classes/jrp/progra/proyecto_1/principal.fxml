<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="700.0" style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #000000);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jrp.progra.proyecto_1.PrincipalController">
   <children>
      <HBox alignment="CENTER" prefHeight="400.0" prefWidth="700.0" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: rgba(34, 52, 91, 0.6); -fx-background-radius: 25; -fx-border-color: #3498db; -fx-border-radius: 25; -fx-border-width: 2;" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="txt" text="Color a Buscar" textAlignment="CENTER" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="36.0" />
                     </font>
                  </Label>

                  <Label fx:id="color" alignment="CENTER" prefHeight="70.0" prefWidth="533.0" style="-fx-effect: dropshadow(gaussian, black, 10, 0, 0, 2);" text="Color" textAlignment="CENTER" textFill="WHITE" VBox.vgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="48.0" />
                     </font>
                  </Label>

                  <VBox alignment="CENTER" spacing="20.0">
                     <children>
                        <HBox alignment="CENTER" spacing="20.0">
                           <children>
                              <Button fx:id="boton1" mnemonicParsing="false" onAction="#clickRojo" prefHeight="50.0" prefWidth="140.0" style="-fx-background-color: #e74c3c; -fx-background-radius: 15; -fx-text-fill: white;  -fx-cursor: hand;" text="ROJO">
                                 <font>
                                    <Font name="Arial Bold" size="18.0" />
                                 </font>
                              </Button>
                              <Button fx:id="boton2" mnemonicParsing="false" onAction="#clickAzul" prefHeight="50.0" prefWidth="140.0" style="-fx-background-color: #3498db; -fx-background-radius: 15; -fx-text-fill: white; -fx-cursor: hand;" text="AZUL">
                                 <font>
                                    <Font name="Arial Bold" size="18.0" />
                                 </font>
                              </Button>
                           </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="20.0">
                           <children>
                              <Button fx:id="boton3" mnemonicParsing="false" onAction="#clickVerde" prefHeight="50.0" prefWidth="140.0" style="-fx-background-color: #2ecc71; -fx-background-radius: 15; -fx-text-fill: white; -fx-cursor: hand;" text="VERDE">
                                 <font>
                                    <Font name="Arial Bold" size="18.0" />
                                 </font>
                              </Button>
                              <Button fx:id="boton4" mnemonicParsing="false" onAction="#clickAmarillo" prefHeight="50.0" prefWidth="140.0" style="-fx-background-color: #f1c40f; -fx-background-radius: 15; -fx-text-fill: black; -fx-cursor: hand;" text="AMARILLO">
                                 <font>
                                    <Font name="Arial Bold" size="18.0" />
                                 </font>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <Label fx:id="logo" textFill="WHITE">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </VBox>

            <VBox alignment="CENTER" prefHeight="350.0" prefWidth="220.0" spacing="25.0" style="-fx-background-color: rgba(255, 255, 255, 0.1); -fx-background-radius: 25; -fx-border-color: rgba(255, 255, 255, 0.3); -fx-border-radius: 25; -fx-border-width: 1px;">
               <children>
                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label text="PUNTAJE" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label fx:id="puntaje" alignment="CENTER" text="0" textFill="#f1c40f">
                           <font>
                              <Font name="System Bold" size="40.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  
                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label text="TIEMPO" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Label fx:id="temporizador" alignment="CENTER" text="0" textFill="#e74c3c">
                           <font>
                              <Font name="System Bold" size="40.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button fx:id="reinicio" mnemonicParsing="false" onAction="#reinicio" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #95a5a6; -fx-background-radius: 10; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand; " text="Reiniciar" />
                        <Button fx:id="btnVolverMenu" mnemonicParsing="false" onAction="#volverMenu" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-text-fill:white; -fx-font-weight: bold; white; -fx-cursor: hand;" text="Menú" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
