<AnchorPane id="AnchorPane" minHeight="-Infinity" minWidth="-Infinity" prefHeight="303.0" prefWidth="600.0" scaleShape="false" style="-fx-border-width: 1;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jrp.progra.proyecto_1.PrincipalController">
