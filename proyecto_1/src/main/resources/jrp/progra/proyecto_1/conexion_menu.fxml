<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="300.0" prefWidth="400.0" style="-fx-background-color: #2c3e50;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jrp.progra.proyecto_1.ConexionMenuController">
   <children>
      <Label text="CONEXIÓN MULTIJUGADOR" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #34495e; -fx-padding: 20; -fx-border-color: white; -fx-border-radius: 10;">
         <children>
            <Label text="Modo Servidor" textFill="WHITE" />
            <Button mnemonicParsing="false" onAction="#handleCrearServidor" prefWidth="200.0" style="-fx-background-color: #2ecc71;" text="Crear Partida" textFill="WHITE" />
         </children>
      </VBox>

      <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #34495e; -fx-padding: 20; -fx-border-color: white; -fx-border-radius: 10;">
         <children>
            <Label text="Modo Cliente" textFill="WHITE" />
            <TextField fx:id="txtIp" promptText="Dirección IP (ej. 127.0.0.1)" prefWidth="200.0" />
            <Button mnemonicParsing="false" onAction="#handleUnirse" prefWidth="200.0" style="-fx-background-color: #3498db;" text="Unirse a Partida" textFill="WHITE" />
         </children>
      </VBox>
      
      <Label fx:id="lblEstado" text="Esperando acción..." textFill="#bdc3c7" />
      <Button mnemonicParsing="false" onAction="#volverMenu" prefWidth="200.0" style="-fx-background-color: #e74c3c;" text="Volver al Menú" textFill="WHITE" />
   </children>
</VBox>
